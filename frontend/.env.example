# Copy to .env for local development.

# Optional locally: leave unset and requests go to /api, which the Vite dev
# server proxies to http://localhost:3005 (see vite.config.js).
# REQUIRED for any build deployed to a different host than the API -- set it
# in .env.production or in the host's build environment. Include /api.
VITE_API_URL=

# Used by src/supabaseClient.js for the public leaderboard, which queries
# Supabase directly rather than going through the backend. Without these the
# leaderboard renders "Live data not configured."
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
