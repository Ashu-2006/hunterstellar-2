# Build-time configuration for production builds (`npm run build`).
#
# Vite INLINES these into the bundle, so changing one requires a rebuild and
# redeploy -- nothing here is read at runtime.
#
# Committed on purpose: the backend URL is not a secret (it is visible in the
# shipped bundle and in every network request), and leaving it to a host
# dashboard is exactly what broke the last deploy.

# The deployed backend. Must include the /api suffix, and must be https --
# an http URL is blocked as mixed content from an https page.
VITE_API_URL=https://odyssey-production-a1c0.up.railway.app/api

# VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY are deliberately NOT committed
# here. They are needed by the public leaderboard, which queries Supabase
# directly -- set them in your local .env, or in the frontend host's build
# environment. Without them the leaderboard renders "Live data not configured."
