# Point the axios client at the Vite dev proxy, which forwards /api to :3005.
# Without this, api/client.js falls back to http://localhost:5000/api and
# every request 404s against nothing.
VITE_API_URL=/api

# Direct browser client, used by the leaderboard and realtime nudges.
# Use the ANON key here, never the service-role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
