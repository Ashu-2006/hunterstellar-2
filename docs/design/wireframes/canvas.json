  "annotations": [
    {
      "id": "flow-entry",
      "x": 0,
      "y": -150,
      "w": 400,
      "text": "ENTRY — splash plays on first open and after logout only.\nA player already mid-hunt lands straight on their clue."
    },
    {
      "id": "flow-loop",
      "x": 0,
      "y": 700,
      "w": 400,
      "text": "THE LOOP — repeats 4 times.\nClue → passcode → question → fragment → next clue.\nWrong CODE locks 15 min. Wrong ANSWER is free. That asymmetry is stated on both screens."
    },
    {
      "id": "flow-turn",
      "x": 0,
      "y": 1520,
      "w": 460,
      "text": "THE TURN — fires once, after the 4th question.\nNav is hidden here (the only screen that hides it) and SKIP is present from t=0.\nThe headline isn't announcing a twist; it's restating what the player just read in the four lines."
    },
    {
      "id": "flow-end",
      "x": 0,
      "y": 2340,
      "w": 400,
      "text": "THE END — the Null Void takes one last code, then the app is done.\nThe case study is physical; the Finished screen says so in those words."
    },
    {
      "id": "flow-states",
      "x": 0,
      "y": 3160,
      "w": 460,
      "text": "EDGE STATES — these are most of the event-day experience.\nLocked and rate-limited keep the clue readable and route the player to Fragments; nothing is ever a dead end."
    },
    {
      "id": "note-reveal",
      "x": 1800,
      "y": 820,
      "w": 300,
      "text": "PROGRESSIVE REVEAL\nThe rail is the mechanic. Locked stops show ··· and never a name. Stop 5 is a hairline outline until the turn, then violet.\nAll derived from the server's progress — no extra API."
    },
    {
      "id": "note-copy",
      "x": 1800,
      "y": 1640,
      "w": 300,
      "text": "PLACEHOLDER COPY\nProlouge, the four fragment lines and beat 3 of the turn are yours to write. Shown here as shape and length so the layout is honest about what fits."
    }
  ],
  "launch": { "view": "canvas" }
}
